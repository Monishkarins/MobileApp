# CocoaPods config for the karins iOS app (React Native 0.86).
# Resolve react_native_pods.rb via Node so yarn/pnpm hoisting still works on CI.

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Force static frameworks when needed by Firebase / other pods that expect it.
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# RNFB expects Firebase headers as a static framework when not using use_frameworks.
$RNFirebaseAsStaticFramework = true

target 'karins' do
  config = use_native_modules!

  # Modular headers unblock non-modular Firebase pods under RN's static linking.
  pod 'Firebase', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'karinsTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Folly's Expected.h optionally includes coro headers that are stripped from
    # the RN-bundled Folly. Without this define, pods compile-fail with:
    # 'folly/coro/Coroutine.h' file not found (xcodebuild exit 65).
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
        defs = [defs] unless defs.is_a?(Array)
        unless defs.any? { |d| d.to_s.include?('FOLLY_CFG_NO_COROUTINES') }
          defs << 'FOLLY_CFG_NO_COROUTINES=1'
        end
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs

        # Keep C++ flags aligned with the app target so third-party pods see the same Folly config.
        cxx_flags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        cxx_flags = [cxx_flags] unless cxx_flags.is_a?(Array)
        unless cxx_flags.any? { |f| f.to_s.include?('FOLLY_CFG_NO_COROUTINES') }
          cxx_flags << '-DFOLLY_CFG_NO_COROUTINES=1'
        end
        build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cxx_flags
      end
    end
  end
end
